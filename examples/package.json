{
  "name": "@nibblearn/examples",
  "version": "0.0.0",
  "private": true,
  "description": "Example module configurations and complete lessons for Nibblearn (not published).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./modules/*": "./src/modules/*.ts",
    "./lessons/*": "./src/lessons/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "export:json": "node --experimental-strip-types --no-warnings scripts/export-json.mjs"
  },
  "dependencies": {
    "@nibblearn/core": "workspace:^"
  }
}
