{
  "schemaVersion": 1,
  "id": "launching-a-campaign",
  "title": "Launching a Marketing Campaign",
  "description": "From a client brief to a live campaign: plan the work in the right order, know who owns each piece, read the dashboard you will be reporting from, and catch setup mistakes before the client does.",
  "objectives": [
    "Order the stages of a paid media launch",
    "Assign activities to the right team",
    "Find the key sections of the analytics dashboard",
    "Spot configuration mistakes in a campaign setup"
  ],
  "intro": {
    "show": true,
    "estimatedMinutes": 12
  },
  "gamification": {
    "points": true,
    "celebration": true
  },
  "completion": {
    "rule": "score",
    "threshold": 0.6
  },
  "modules": [
    {
      "id": "brief-to-launch",
      "type": "story-cards",
      "title": "It starts with a brief",
      "content": {
        "cards": [
          {
            "layout": "cover",
            "eyebrow": "Chapter 1",
            "title": "Every campaign starts with a brief",
            "body": "A brief answers four questions: **who** we are talking to, **what** we want them to do, **how much** we can spend, and **how** we will know it worked."
          },
          {
            "eyebrow": "The rule",
            "title": "No brief, no build",
            "body": "Media Buying never builds from a Slack message. If a client wants to “just quickly launch something”, Account Management turns the request into a one-page brief first.\n\nIt takes twenty minutes and saves a week."
          },
          {
            "layout": "stat",
            "stat": {
              "value": "48h",
              "label": "from approved brief to launch-ready setup"
            },
            "body": "That is the standard for a search or social campaign with existing creative. Anything faster needs a reason; anything slower needs a plan."
          },
          {
            "eyebrow": "Checkpoint",
            "title": "Creative approval",
            "body": "Creative goes to the client **before** tracking setup, not after. A rejected ad on launch day is the most expensive kind of rejection.",
            "check": {
              "question": "When does the client approve creative?",
              "options": [
                {
                  "text": "Before tracking setup",
                  "correct": true
                },
                {
                  "text": "On launch day"
                },
                {
                  "text": "After the first report"
                }
              ],
              "explanation": "Approval happens before setup so launch day has no surprises."
            }
          }
        ]
      }
    },
    {
      "id": "launch-order",
      "type": "sequence-builder",
      "title": "Launching a paid media campaign",
      "instructions": "Put the seven stages of a Brightline Media campaign launch in the order they happen. Drag the rows or use the arrow buttons.",
      "content": {
        "items": [
          {
            "id": "brief",
            "text": "Receive and clarify the client brief",
            "description": "Everything downstream depends on the objective, budget, audience and timing agreed here."
          },
          {
            "id": "research",
            "text": "Research the audience and the competition",
            "description": "Audience insights and competitor spend shape the channel mix before any money is committed."
          },
          {
            "id": "plan",
            "text": "Build the media plan and budget split",
            "description": "Channels, flighting and the budget split are proposed only once the research is in."
          },
          {
            "id": "creative",
            "text": "Produce and approve creative assets",
            "description": "Creative is cut to the formats the plan requires, so it follows the plan, not the other way round."
          },
          {
            "id": "setup",
            "text": "Set up campaigns, tracking and QA",
            "description": "Ads, audiences and conversion tracking are configured and checked before anything goes live."
          },
          {
            "id": "launch",
            "text": "Launch and optimise in-flight",
            "description": "Once live, bids, budgets and creative rotation are tuned against the plan's targets."
          },
          {
            "id": "report",
            "text": "Report results and recommend next steps",
            "description": "The wrap-up report closes the loop and feeds the next brief."
          }
        ],
        "explanation": "The sequence runs from understanding (brief, research) to planning, to production (creative, setup), and finally to execution and learning (launch, report). Skipping a step usually means redoing a later one.",
        "hint": "You cannot plan what you have not researched, and you cannot build what you have not planned."
      },
      "behavior": {
        "allowRetry": true,
        "maxAttempts": 3,
        "showExplanation": true,
        "showPositions": true
      },
      "feedback": {
        "complete": "That is the Brightline launch playbook. Keep it handy for your first campaign."
      }
    },
    {
      "id": "launch-ownership",
      "type": "category-sort",
      "title": "Who does what at Brightline Media",
      "instructions": "Sort each activity into the team that owns it. Drag an item into a category, or tap the item and then the category.",
      "content": {
        "categories": [
          {
            "id": "strategy",
            "label": "Strategy",
            "description": "Objectives, audiences and the plan",
            "color": "accent"
          },
          {
            "id": "media",
            "label": "Media Buying",
            "description": "Running the money in-platform",
            "color": "warning"
          },
          {
            "id": "analytics",
            "label": "Analytics",
            "description": "Tracking, measurement and insight",
            "color": "info"
          },
          {
            "id": "account",
            "label": "Account Management",
            "description": "The client relationship",
            "color": "success"
          }
        ],
        "items": [
          {
            "id": "brief",
            "text": "Translate the client brief into campaign objectives",
            "categoryId": "strategy",
            "explanation": "Strategy turns the brief into measurable objectives before any channel is chosen."
          },
          {
            "id": "bids",
            "text": "Adjust bids and budgets in the ad platforms",
            "categoryId": "media",
            "explanation": "In-flight bid and budget changes are hands-on-keyboard media buying work."
          },
          {
            "id": "pixel",
            "text": "Install and verify conversion tracking",
            "categoryId": "analytics",
            "explanation": "Analytics owns the tracking stack so that every team reports from the same numbers."
          },
          {
            "id": "qbr",
            "text": "Run the quarterly business review with the client",
            "categoryId": "account",
            "explanation": "QBRs are a relationship ritual led by the account team, with input from the others."
          },
          {
            "id": "personas",
            "text": "Define target audience personas",
            "categoryId": "strategy",
            "explanation": "Personas are a planning artefact that media and creative then act on."
          },
          {
            "id": "placements",
            "text": "Choose placements and exclude low-quality inventory",
            "categoryId": "media",
            "explanation": "Placement selection and brand-safety exclusions are configured by the buyers."
          },
          {
            "id": "dashboard",
            "text": "Build the weekly performance dashboard",
            "categoryId": "analytics",
            "explanation": "Dashboards are an analytics deliverable, even though account managers present them."
          },
          {
            "id": "scope",
            "text": "Negotiate scope changes and invoicing",
            "categoryId": "account",
            "explanation": "Commercial conversations about scope and billing sit with account management."
          },
          {
            "id": "attribution",
            "text": "Pick the attribution model for reporting",
            "categoryId": "analytics",
            "explanation": "Attribution is a measurement decision; analytics recommends it, strategy signs it off."
          },
          {
            "id": "channelmix",
            "text": "Recommend the channel mix and budget split",
            "categoryId": "strategy",
            "explanation": "The channel mix is a strategic recommendation that media buying then executes."
          }
        ],
        "hint": "Ask who would be blamed if the task went wrong: the planner, the buyer, the analyst or the client lead."
      },
      "behavior": {
        "allowRetry": true,
        "maxAttempts": 3,
        "showExplanation": true,
        "shuffle": true
      },
      "feedback": {
        "complete": "You now know who to ask for what. Expect to hand off work across all four teams in your first month."
      }
    },
    {
