{
  "name": "nibblearn-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Nibblearn \u2014 tiny interactions, real learning. Open-source React library for building interactive learning experiences.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @nibblearn/showcase dev",
    "build": "pnpm -r --filter './packages/*' build",
    "build:showcase": "pnpm --filter @nibblearn/showcase build",
    "build:all": "pnpm build && pnpm build:showcase",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:package": "pnpm --filter './packages/*' check:package",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "storybook": "pnpm --filter @nibblearn/storybook dev",
    "build:storybook": "pnpm --filter @nibblearn/storybook build",
    "test:coverage": "vitest run --coverage",
    "check:docs": "node scripts/qa/docs-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
