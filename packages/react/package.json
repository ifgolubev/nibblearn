{
  "name": "@nibblearn/react",
  "version": "0.1.0",
  "description": "Tiny interactions. Real learning. Beautiful, accessible, interactive learning modules and a Lesson Player for React \u2014 flashcards, matching, branching scenarios, simulations and more, driven by JSON or components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && dts-bundle-generator src/index.ts -o dist/index.d.ts --project tsconfig.build.json --no-banner --export-referenced-types=false --silent && node ../../scripts/finish-dts.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@nibblearn/core": "workspace:^",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifgolubev/nibblearn.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ifgolubev/nibblearn#readme",
  "bugs": {
    "url": "https://github.com/ifgolubev/nibblearn/issues"
  },
  "keywords": [
    "components",
    "education",
    "elearning",
    "flashcards",
    "interactive",
    "learning",
    "microlearning",
    "nibblearn",
    "onboarding",
    "quiz",
    "react",
    "training",
    "ui"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
