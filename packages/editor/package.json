{
  "name": "@nibblearn/editor",
  "version": "0.4.1",
  "description": "Authoring UI for Nibblearn: schema-driven forms, live preview, a block picker and a lesson editor for all built-in modules.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/dts-shim.mjs . core react && dts-bundle-generator src/index.ts -o dist/index.d.ts --project tsconfig.build.json --no-banner --export-referenced-types=false --silent && node ../../scripts/finish-dts.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile node16 --exclude-entrypoints styles.css"
  },
  "dependencies": {
    "@nibblearn/core": "workspace:^",
    "@nibblearn/react": "workspace:^",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifgolubev/nibblearn.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/ifgolubev/nibblearn#readme",
  "bugs": {
    "url": "https://github.com/ifgolubev/nibblearn/issues"
  },
  "keywords": [
    "nibblearn",
    "editor",
    "authoring",
    "forms",
    "json-schema",
    "elearning",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
