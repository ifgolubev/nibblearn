{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "baseUrl": ".",
    "paths": {
      "@nibblearn/core": [".dts-shim/node_modules/@nibblearn/core/index.d.ts"],
      "@nibblearn/react": [".dts-shim/node_modules/@nibblearn/react/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.tsx", "src/**/*.test.ts"]
}
