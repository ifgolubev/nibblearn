{
  "name": "@nibblearn/core",
  "version": "0.1.0",
  "description": "Engine, schemas, validation and types for Nibblearn interactive learning content. Framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && dts-bundle-generator -o dist/index.d.ts --project tsconfig.build.json --no-banner --export-referenced-types=false --silent src/index.ts && node ../../scripts/finish-dts.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "publint": "0.3.25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ifgolubev/nibblearn.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ifgolubev/nibblearn#readme",
  "bugs": {
    "url": "https://github.com/ifgolubev/nibblearn/issues"
  },
  "keywords": [
    "education",
    "elearning",
    "flashcards",
    "learning",
    "microlearning",
    "nibblearn",
    "quiz",
    "schema",
    "zod"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
